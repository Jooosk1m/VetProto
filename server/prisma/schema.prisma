
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?  
  createdAt DateTime @default(now())
}

model Pet {
  id        Int      @id @default(autoincrement())
  name      String
  species   String
  createdAt DateTime @default(now())
}